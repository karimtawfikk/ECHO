FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# System dependencies for OpenCV
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/hieroglyph.txt .
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r hieroglyph.txt

COPY src/hieroglyph_api src/hieroglyph_api
COPY src/hieroglyph_models src/hieroglyph_models
COPY src/db src/db

EXPOSE 8003

CMD ["uvicorn", "src.hieroglyph_api.main:app", "--host", "0.0.0.0", "--port", "8003"]